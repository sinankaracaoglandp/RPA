<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Yerel geliştirici sırları (DB bağlantısı vb.) için user-secrets; repo dışında saklanır. -->
    <UserSecretsId>rpa-webapi-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testler SecretHasher/SecretGenerator'i (internal) dogrudan kullanir: credential rotasyonu
         testleri hash semasini kopyalamak yerine URETIM semasini cagirmalidir. -->
    <InternalsVisibleTo Include="RPA.WebAPI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPA.Infrastructure\RPA.Infrastructure.csproj" />
    <ProjectReference Include="..\RPA.Application\RPA.Application.csproj" />
    <ProjectReference Include="..\RPA.Domain\RPA.Domain.csproj" />
  </ItemGroup>

</Project>
