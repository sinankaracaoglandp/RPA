{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=RPA_Dev;Trusted_Connection=true;"
  },
  "Agent": {
    "OrchestratorUrl": "https://localhost:5001",
    "MachineName": "",
    "Mode": "Unattended",
    "Tags": "",
    "Capacity": 1,
    "QueueId": "00000000-0000-0000-0000-000000000000",
    "PollInterval": "00:00:05",
    "HeartbeatInterval": "00:00:30",
    "Session": {
      "AllowAutoLogon": false,
      "AutoLogonUserName": "",
      "AutoLogonDomain": "",
      "AutoLogonPasswordVaultKey": "autologon-robot-password"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
