  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RPA.Domain\RPA.Domain.csproj" />
    <ProjectReference Include="..\..\src\RPA.Infrastructure\RPA.Infrastructure.csproj" />
  </ItemGroup>

</Project>
